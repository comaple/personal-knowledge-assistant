# 不填 Key 也能使用默认的本地检索模式。
# DSH 问答需先 npm ci，再复制本文件为 .env 填写 Key，并重启 app.py。
LLM_API_KEY=
DSH_MODEL=deepseek-flash
# DSH 官方适配器使用 Messages 协议，不是 /chat/completions。
DSH_BASE_URL=https://api.deepseek.com/anthropic

# 图谱与向量：python -m pip install -r requirements-rag.lock 后构建索引。
RAG_ENABLED=true
# 图谱抽取/检索词提取使用 Chat Completions；与 DSH Messages 配置分开。
RAG_LLM_BASE_URL=https://api.deepseek.com
RAG_LLM_MODEL=deepseek-flash
# 留空时复用 LLM_API_KEY。
RAG_LLM_API_KEY=
# 示例：本地 Ollama。先安装 Ollama 并运行 ollama pull bge-m3。
EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
EMBEDDING_API_KEY=ollama
