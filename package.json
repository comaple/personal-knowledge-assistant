{
  "name": "personal-knowledge-assistant",
  "version": "1.0.0-rc.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.9.0"
  },
  "scripts": {
    "test:harness": "node --test harness/integration.test.mjs",
    "test:python": "python -m unittest -v test_project.py test_rag test_acceptance",
